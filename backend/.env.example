# Environment Mode: development / production
ENVIRONMENT=development

# Server Settings
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "*"]

# Database Configuration (PostgreSQL with SQLite local fallback)
DATABASE_URL=sqlite:///./misinfo_app.db
# For PostgreSQL production:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/misinfo_db

# AI Provider Settings: "auto", "groq", "gemini", "openai", "anthropic", or "mock"
AI_PROVIDER=auto

# 1. Groq API Key (Recommended - Free, High Speed Llama-3.3 70B):
# Get free key at: https://console.groq.com/keys
GROQ_API_KEY=

# 2. Google Gemini API Key (Free tier available):
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 3. OpenAI API Key (GPT-4o-mini):
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 4. Anthropic Claude API Key:
ANTHROPIC_API_KEY=

# Gmail SMTP Configuration (Sends 6-digit verification code directly to user's Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
