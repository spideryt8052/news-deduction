# Environment Mode: development / production
ENVIRONMENT=development

# Server Settings
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "*"]

# Database Configuration (PostgreSQL with SQLite local fallback)
DATABASE_URL=sqlite:///./misinfo_app.db
# For PostgreSQL production:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/misinfo_db

# AI Provider Settings (Optional for live LLM mode, falls back to mock analyzer)
AI_PROVIDER=mock
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
